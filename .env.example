# ---------------------------------------------------------------------------
# Google Workspace OAuth (OpenID Connect) — CLIENT-SIDE VALUES ONLY
# ---------------------------------------------------------------------------
# The OAuth *Client ID* is public by design; it is safe to ship in the bundle.
# NEVER put the OAuth Client SECRET here — the secret lives only on the backend
# and is used exclusively there to exchange the authorization code for tokens.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Corporate Workspace domain. Used ONLY as a UX hint (`hd`) to pre-filter the
# Google account chooser. The real domain enforcement happens on the backend,
# which must reject any ID token whose verified `hd` claim != this value.
VITE_CORPORATE_DOMAIN=miempresa.com

# Base path of your backend API. Same-origin ("/api") is strongly recommended
# so the HttpOnly session cookie stays first-party (SameSite=Strict works).
VITE_API_BASE=/api

# Dev-only: where Vite proxies /api during `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:8080

# 'google' (real) | 'mock' (DEV ONLY: salta el popup de Google y usa el backend
# mock para probar sin credenciales reales). En producción debe ser 'google'.
VITE_AUTH_MODE=google

# ---------------------------------------------------------------------------
# Mapa — proveedor de teselas PROPIO (opcional)
# ---------------------------------------------------------------------------
# Sin esto la app usa Esri World Street Map y, si no responde, CARTO Voyager
# (gratuitos, sin garantía de servicio). NO se usa OpenStreetMap: bloquea las
# apps desplegadas (403 "Access blocked"). Para una garantía real, define un
# proveedor con contrato/llave (MapTiler, Mapbox, Stadia, ArcGIS...). Son
# variables de BUILD (Vite las incrusta): en Render, agrégalas como variables de
# entorno del servicio antes de desplegar. La llave queda visible en el
# navegador, así que restríngela por dominio en el panel del proveedor.
# Ejemplo:
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=TU_LLAVE
# VITE_MAP_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
# VITE_MAP_TILE_MAX_ZOOM=19
