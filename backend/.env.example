# ---------------------------------------------------------------------------
# Backend Promotores — configuración
# ---------------------------------------------------------------------------

# Puerto del servidor.
PORT=8080

# Origen del frontend permitido para CORS (con credenciales).
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (Prisma / PostgreSQL) -----------------------------------
# En Render el DATABASE_URL lo inyecta automáticamente el servicio de Postgres
# (ver render.yaml). En local, apunta a tu propio Postgres:
DATABASE_URL="postgresql://user:pass@host:5432/ferreteros?schema=public"

# Carpeta con los CSV del seed (Promotores, Clientes, Sucursales, Productos).
# Por defecto: prisma/seed-data (datos DEMO).
# SEED_DIR=./prisma/seed-data

# Radio de check-in en metros (GPS real). Protexa: 100 m.
CHECK_IN_RADIUS_METERS=100

# Radio (m) para listar tiendas cercanas en GET /api/stores?lat&lng.
NEARBY_RADIUS_METERS=2000

# --- Sesión ----------------------------------------------------------------
# Secreto para firmar el JWT de sesión que va dentro de la cookie HttpOnly.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
# Duración de la sesión (segundos). 8h por defecto.
SESSION_TTL_SECONDS=28800
# 'true' en producción (HTTPS) para marcar la cookie como Secure.
COOKIE_SECURE=false

# --- Google Sheets (admin) — opcional --------------------------------------
# Al hacer check-out se agrega una fila con los datos de la visita al Sheet.
# 1) Crea un Service Account en Google Cloud y descarga su clave JSON.
# 2) Habilita la Google Sheets API.
# 3) Comparte el documento con el client_email del Service Account (editor).
# Si estos valores quedan vacíos, la integración se omite (no rompe el check-out).
# Credenciales de UNA forma: el JSON completo en una línea (GOOGLE_SERVICE_ACCOUNT_JSON)
# o la ruta a un archivo JSON (GOOGLE_SERVICE_ACCOUNT_KEY_FILE).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Visitas

# Origen de login/catálogo y pestañas del libro.
AUTH_SOURCE=sheet
# "sheet" sincroniza Clientes, Sucursales y Productos desde el Sheet; "db" usa la base tal cual.
CATALOG_SOURCE=sheet
GOOGLE_SHEETS_PROMOTERS_TAB=Promotores
GOOGLE_SHEETS_CLIENTES_TAB=Clientes
GOOGLE_SHEETS_SUCURSALES_TAB=Sucursales
GOOGLE_SHEETS_PRODUCTOS_TAB=Productos
# Pestaña de usuarios administrativos (admin/gerente/supervisor).
GOOGLE_SHEETS_USUARIOS_TAB=Usuarios

# Auditoría de cada check-in/check-out.
GOOGLE_SHEETS_ACTIVIDAD_TAB=Actividad Diaria

# --- Metas, notificaciones y competencia (pestañas del Sheet) ---------------
# Metas de venta mensuales (unidades = rollos+cubetas) por promotor y tienda.
GOOGLE_SHEETS_METAS_TAB=Metas
# Notificaciones (check-in, meta alcanzada) para supervisores/admin.
GOOGLE_SHEETS_NOTIFICACIONES_TAB=Notificaciones
# Resumen de reportes de competencia (las fotos van a la base de datos, no aquí).
GOOGLE_SHEETS_COMPETENCIA_TAB=Competencia

# --- Correo (reporte semanal de KPIs para el admin) -------------------------
# SMTP genérico. Con Google Workspace/Gmail: host smtp.gmail.com, puerto 587,
# usuario = la cuenta, contraseña = una "contraseña de aplicación" (no la
# contraseña normal si la cuenta tiene verificación en 2 pasos). Si falta
# cualquiera de estas, el correo se omite (el reporte in-app sigue igual).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# A quién se le manda el reporte semanal por correo.
ADMIN_REPORT_EMAIL=
