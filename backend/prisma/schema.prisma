// Esquema de datos — Ferreteros APP
// Motor: PostgreSQL en los servidores (Render). Este archivo se versiona con
// provider = "postgresql". Para LOCAL con SQLite NO lo edites: usa
// `npm run db:local` (backend/scripts/prisma-local.mjs genera una copia ignorada
// por git con provider = "sqlite"). El resto del código (queries Prisma) es idéntico.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Promoter {
  id                 String              @id // ID de promotor (número de la BBDD)
  name               String
  location           String? // UBICACION
  supervisor         String? // SUPERVISOR
  estado             String? // ESTADO de México asignado al promotor (columna "Estado" de la pestaña Promotores). Fijo, no se deriva de las sucursales visitadas.
  password           String // hash bcrypt de la contraseña (nunca en texto plano)
  createdAt          DateTime            @default(now())
  visits             VisitRecord[]
  competitionReports CompetitionReport[]
  trainingProgress   TrainingProgress[]
  threads            Thread[]
}

// Cliente ferretero (cadena o grupo). Tiene varias sucursales; el catálogo se
// sincroniza desde la pestaña Clientes del Sheet (ver catalogSync.js).
model Cliente {
  id         String     @id
  nombre     String
  estado     String? // ESTADO de México del cliente (opcional)
  sucursales Sucursal[]
}

// Sucursal de un cliente: ahí se hace el check-in/out por GPS. Catálogo GLOBAL
// (sin asignación por promotor); la visibilidad se resuelve por cercanía
// geográfica en tiempo real (GET /api/sucursales?lat&lng).
model Sucursal {
  id        String        @id // columna Num de la pestaña Sucursales
  cliente   Cliente       @relation(fields: [clienteId], references: [id])
  clienteId String
  name      String
  address   String
  lat       Float
  lng       Float
  estado    String? // ESTADO de México (columna "Estado" de la pestaña Sucursales). Usado por el filtro del gerente.
  visits    VisitRecord[]

  @@index([clienteId])
}

// Producto del catálogo configurable (pestaña Productos del Sheet). La meta
// cuenta cantidad × equivalencia; el dinero, cantidad × precio. Un producto con
// activo = false deja de salir en el formulario pero conserva su historial.
model Producto {
  id           String      @id
  nombre       String
  unidad       String      @default("pza")
  equivalencia Float       @default(1)
  precio       Float       @default(0)
  activo       Boolean     @default(true)
  orden        Int         @default(0)
  items        VisitItem[]
}

model VisitRecord {
  id               String      @id @default(uuid())
  promoter         Promoter    @relation(fields: [promoterId], references: [id])
  promoterId       String
  sucursal         Sucursal    @relation(fields: [sucursalId], references: [id])
  sucursalId       String
  day              String // YYYY-MM-DD — 1 visita por promotor/sucursal/día
  status           String // "checked-in" | "checked-out"
  checkInTime      DateTime?
  checkInDistance  Int?
  checkOutTime     DateTime?
  checkOutDistance Int?
  items            VisitItem[]
  photo            String? // foto de la visita en Base64 (data URL), persistida
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([promoterId, sucursalId, day])
  @@index([promoterId, day])
}

// Cantidad vendida de un producto en una visita (se llena en el check-out).
model VisitItem {
  id         String      @id @default(uuid())
  visit      VisitRecord @relation(fields: [visitId], references: [id], onDelete: Cascade)
  visitId    String
  producto   Producto    @relation(fields: [productoId], references: [id])
  productoId String
  cantidad   Int

  @@unique([visitId, productoId])
}

// Reporte de acciones/estrategias de la competencia, capturado desde la
// pantalla "Competencia" de la app del promotor. Las fotos se guardan aquí
// (Base64, como VisitRecord.photo) — un Sheet no es buen lugar para binarios;
// el Sheet solo recibe una fila-resumen (ver competitionSheet.js).
model CompetitionReport {
  id          String   @id @default(uuid())
  promoter    Promoter @relation(fields: [promoterId], references: [id])
  promoterId  String
  marca       String
  descripcion String
  photos      String? // JSON: array de fotos en Base64 (data URL)
  createdAt   DateTime @default(now())

  @@index([promoterId])
}

// Progreso de Capacitación/Soporte de un promotor: una fila por pregunta de
// quiz o tarjeta Leitner que ya intentó, para cada sección ("capacitacion" |
// "soporte" — mismo tablero de contenido, distinto tema). `itemKey` es el
// "Orden" de esa pregunta/tarjeta en la pestaña del Sheet correspondiente
// (ver trainingSheet.js) — si el Sheet se reordena después, el progreso de
// ese ítem podría desalinearse; es una limitación aceptada de tener el
// contenido en un Sheet editable a mano, no de la base de datos.
model TrainingProgress {
  id         String   @id @default(uuid())
  promoter   Promoter @relation(fields: [promoterId], references: [id])
  promoterId String
  seccion    String // "capacitacion" | "soporte"
  tipo       String // "pregunta" | "flashcard"
  itemKey    String // "Orden" de la pregunta/tarjeta en el Sheet
  box        Int      @default(1) // Leitner (1-5): solo aplica a "flashcard"
  attempts   Int      @default(0)
  correct    Int      @default(0)
  lastResult Boolean? // último intento: acertó/recordó o no
  updatedAt  DateTime @updatedAt

  @@unique([promoterId, seccion, tipo, itemKey])
  @@index([promoterId, seccion])
}

// Hilo de comentarios estilo FORO (no chat en vivo): una lista de comentarios
// con autor, fecha y hora que se va agregando y respondiendo. Sirve para dos
// cosas, distinguidas por `kind`:
//   - "supervisor": el chat de UN supervisor con la administración (un solo
//     hilo por supervisor, `supervisorId` único = su ID de login en minúsculas).
//   - "ticket": el seguimiento de UN reporte ("Reportar") de un promotor. El
//     texto original del reporte es el primer comentario del hilo.
// `lastCommentAt`/`lastAuthorRole` se guardan aquí (denormalizados) para poder
// listar hilos y calcular "sin leer" sin tener que leer los comentarios.
model Thread {
  id             String          @id @default(uuid())
  kind           String // "supervisor" | "ticket"
  supervisorId   String?         @unique
  promoter       Promoter?       @relation(fields: [promoterId], references: [id])
  promoterId     String?
  sucursal       String?
  title          String?
  status         String          @default("abierto") // "abierto" | "cerrado" (solo tickets)
  lastCommentAt  DateTime        @default(now())
  lastAuthorRole String          @default("")
  createdAt      DateTime        @default(now())
  comments       ThreadComment[]

  @@index([kind, lastCommentAt])
  @@index([promoterId, lastCommentAt])
}

model ThreadComment {
  id         String   @id @default(uuid())
  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId   String
  authorId   String // ID de login de quien escribe (promotor, supervisor o admin)
  authorName String
  authorRole String // "promotor" | "supervisor" | "admin" | "gerente"
  text       String
  createdAt  DateTime @default(now())

  @@index([threadId, createdAt])
}
